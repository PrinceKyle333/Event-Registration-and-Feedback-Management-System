# Central Mindanao University (CMU) - Event Registration & Evaluation System
# BSIT 4B System Integration and Architecture (SIA) Configuration

# Port for Express API and Vite Dev Server
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random value and never commit the real one.
JWT_SECRET="122333444455555"
# How long a login stays valid
JWT_EXPIRES_IN="8h"

# MySQL Database Configuration (required)
# The server creates the database and tables on first start and inserts demo data.
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="event_evaluation_system"

# Gemini API Key (Optional, injected by AI Studio for smart features)
GEMINI_API_KEY=""

# Application URL
APP_URL="http://localhost:3000"
