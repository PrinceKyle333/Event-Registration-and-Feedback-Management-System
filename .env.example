# Central Mindanao University (CMU) - Event Registration & Evaluation System
# BSIT 4B System Integration and Architecture (SIA) Configuration

# Port for Express API and Vite Dev Server
PORT=3000

# Session/JWT Secret for Authentication
JWT_SECRET="cmu_sia_secret_key_2026_bsit4b"

# MySQL Database Configuration
# If provided and MySQL is running, system connects to MySQL.
# Otherwise, built-in persistent relational JSON database engine is automatically used.
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="event_evaluation_system"

# Gemini API Key (Optional, injected by AI Studio for smart features)
GEMINI_API_KEY=""

# Application URL
APP_URL="http://localhost:3000"
